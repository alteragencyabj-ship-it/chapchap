# Backend API URL (required)
# Local dev: http://192.168.1.69:8001 (or your machine IP)
# Staging:   https://chapchap-api-staging.onrender.com
# Prod:      https://api.chapchap.ci
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.69:8001

# Expo project ID for push notifications (required for EAS builds)
# Get from: https://expo.dev -> your project -> Project ID
EXPO_PUBLIC_EXPO_PROJECT_ID=your-expo-project-id

# Google Maps API key (optional, for map features)
# Get from: https://console.cloud.google.com -> APIs & Services -> Credentials
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-key
