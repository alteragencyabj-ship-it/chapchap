# =============================================================================
# ChapChap Backend Environment Variables
# =============================================================================
# Copy to .env and fill in values.
# Variables marked [REQUIRED IN PROD] must be set for production deployment.

# Environment: development | staging | production
# In production: secrets validation is enforced, CORS is strict.
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=artisan_connect

# -----------------------------------------------------------------------------
# JWT Authentication [REQUIRED IN PROD]
# -----------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Must be 32+ chars in production. Default value will FAIL in production.
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Firebase (optional -- fallback to JWT if not configured)
# -----------------------------------------------------------------------------
# FIREBASE_CREDENTIALS_PATH=./firebase-admin-test.json

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001

# -----------------------------------------------------------------------------
# CORS [REQUIRED IN PROD]
# -----------------------------------------------------------------------------
# Comma-separated allowed origins. Use * for local dev only.
# Example staging: https://staging.chapchap.ci
# Example prod:    https://chapchap.ci,https://www.chapchap.ci
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# Provider: mock (dev/test) or wave (production)
PAYMENT_PROVIDER=mock

# Wave CI credentials (required when PAYMENT_PROVIDER=wave)
# Get from: https://business.wave.com -> API Settings
# WAVE_API_KEY=
# WAVE_API_SECRET=
# WAVE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Push Notifications (optional)
# -----------------------------------------------------------------------------
# Expo access token for server-side push (if needed)
# EXPO_ACCESS_TOKEN=
