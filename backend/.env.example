# === Servicio Backend — Required Environment Variables ===

# MongoDB connection string (MongoDB Atlas recommended)
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/servicio

# Database name
DB_NAME=servicio

# JWT Secret (generate a strong random string)
JWT_SECRET=your-secret-key-here

# JWT Algorithm
JWT_ALGORITHM=HS256

# Environment (development | staging | production)
ENVIRONMENT=production

# CORS — frontend URL(s), comma-separated
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app

# Payment provider (mock for dev, stripe for prod)
PAYMENT_PROVIDER=mock

# Stripe (when ready)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
